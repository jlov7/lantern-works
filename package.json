{
  "name": "lantern-works",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 47613",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "balance": "tsx scripts/balance.ts",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm balance && pnpm build && pnpm size && pnpm e2e",
    "coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs",
    "test:compat": "playwright test --config playwright.compat.config.ts",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "public:check": "node scripts/public-source.mjs --check",
    "public:export": "node scripts/public-source.mjs",
    "test:public-source": "node --test scripts/public-source.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "oxlint": "1.81.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A browser game about a neighbourhood creative studio and the work it leaves behind.",
  "license": "SEE LICENSE IN LICENSE"
}
